{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@vda/contracts": ["./packages/contracts/src/index.ts"],
      "@vda/contracts/*": ["./packages/contracts/src/*"],
      "@vda/mock-warehouse": ["./packages/mock-warehouse/src/index.ts"],
      "@vda/mock-warehouse/*": ["./packages/mock-warehouse/src/*"]
    }
  }
}
